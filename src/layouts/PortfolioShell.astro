---
import { crtExperiment } from '../data/crt-experiment.mjs';
import ScrollSections from '../components/ScrollSections.astro';
import IdleScreensaver from '../components/IdleScreensaver.astro';
import ScrollNavigation from '../components/ScrollNavigation.astro';
import PortfolioFooter from '../components/PortfolioFooter.astro';
import packageInfo from '../../package.json';
import StaticReader from '../components/StaticReader.astro';
import { portfolioDictionaries } from '../data/portfolio.mjs';
import { typographyMode } from '../data/typography.mjs';

const {
  title = 'Edoardo Rappanello — Multidisciplinary Designer',
  description = 'Portfolio of Edoardo Rappanello. Graphic design, web and digital marketing across independent projects and ongoing communication work.',
  canonicalPath = '',
  ogImage = 'assets/images/profilephoto.webp',
  ogType = 'website',
  jsonLd = null,
  project = null
} = Astro.props;

const fontSheet = typographyMode === 'doto-mono'
  ? 'https://fonts.googleapis.com/css2?family=Doto:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600;700&display=swap'
  : typographyMode === 'pixel-editorial'
  ? 'https://fonts.googleapis.com/css2?family=Doto:wght@400;500;600;700&family=Geist+Pixel:ELSH@0..100&family=Geist:wght@400;500;600;700&display=swap'
  : typographyMode === 'balanced'
  ? 'https://fonts.googleapis.com/css2?family=Doto:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap'
  : typographyMode === 'digital'
  ? 'https://fonts.googleapis.com/css2?family=Doto:wght@400;500;600;700&family=Geist+Pixel:ELSH@0..100&display=swap'
  : 'https://fonts.googleapis.com/css2?family=Doto:wght@400;500;600;700&display=swap';
const assetVersion = packageInfo.version;
const asset = path => `${path}?v=${assetVersion}`;
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const rootUrl = new URL(basePath, Astro.site ?? Astro.url.origin);
const canonicalUrl = new URL(canonicalPath, rootUrl);
const ogImageUrl = new URL(ogImage, rootUrl);
---
<!doctype html>
<html lang="en" class="no-js fonts-pending" data-typography={typographyMode} data-crt-format={crtExperiment.classicDesktop ? "classic" : "wide"} style={`--crt-desktop-ratio: ${crtExperiment.desktopRatio}`}>
<head>
  <meta charset="utf-8" />
  <style is:inline>
    /* First paint protection: not one frame of system-font fallback, even
       before bundled CSS or remote font stylesheets have been received. */
    html.fonts-pending .boot-gate h2,
    html.fonts-pending .shell,
    html.fonts-pending .static-reader {
      visibility:hidden!important;
    }
    /* Reading mode must work without JavaScript even if fonts-pending stays set.
       Normal scripted UI stays protected against a fallback-font flash. */
    html.no-js.fonts-pending .static-reader,
    html.fonts-pending body.reader-mode .static-reader {
      visibility:visible!important;
    }
  </style>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <base href={basePath} />
  <meta name="theme-color" content="#050505" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <title>{title}</title>
  <link rel="icon" href="assets/favicon/favicon-er.svg" type="image/svg+xml" />
  <link rel="icon" href="assets/favicon/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="assets/favicon/favicon-64.png" sizes="64x64" type="image/png" />
  <link rel="shortcut icon" href="assets/favicon/favicon-32.png" type="image/png" />
  <script is:inline define:vars={{assetVersion}}>
    document.documentElement.classList.remove('no-js');
    window.PORTFOLIO_ASSET_VERSION = assetVersion;
    try {
      if (sessionStorage.getItem('portfolioBootSeen') === '1') {
        document.documentElement.classList.add('returning-visit');
      }
    } catch {}
    try {
      if (localStorage.getItem('portfolioBootSeen') === '1') {
        document.documentElement.classList.add('returning-visit');
      }
    } catch {}
  </script>
  {import.meta.env.PROD
    ? <link rel="stylesheet" href={asset('css/portfolio.bundle.css')} />
    : <><link rel="stylesheet" href="css/foundation.css" />
       <link rel="stylesheet" href="css/workspace.css" />
       <link rel="stylesheet" href="css/visual-experience.css" />
       <link rel="stylesheet" href="css/adaptive.css" />
       <link rel="stylesheet" href="css/fixes.css" />
       <link rel="stylesheet" href="css/crt-outline-base.css" />
       <link rel="stylesheet" href="css/project-covers.css" />
       <link rel="stylesheet" href="css/monochrome-theme.css" />
       <link rel="stylesheet" href="css/crt-outline.css" />
       <link rel="stylesheet" href="css/portfolio-scroll.css" />
       <link rel="stylesheet" href="css/typography.css" /></>
  }
  {!project && <>
    <link rel="modulepreload" href={asset('js/head3d.js')} fetchpriority="high" />
    <!-- Keep the large main-thread Three.js bundle out of the preload chain:
         Chromium uses the Worker bundle and fallback browsers request it on demand. -->
    <link rel="preload" href="assets/models/human_head_reference3.glb" as="fetch" crossorigin="anonymous" fetchpriority="high" />
  </>}
  <link rel="stylesheet" href={asset('css/idle-screensaver.css')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={fontSheet} />
  {(typographyMode === 'balanced' || typographyMode === 'original') && <link rel="preload" href="assets/font/redaction-50-latin-400-normal.woff" as="font" type="font/woff" crossorigin />}
  <link rel="preload" as="image" href="assets/cursors/default-alt-mono.svg" type="image/svg+xml" media="(hover:hover) and (pointer:fine)" />
  <link rel="preload" as="image" href="assets/cursors/pointer-mono.svg" type="image/svg+xml" media="(hover:hover) and (pointer:fine)" />
  <link rel="preload" as="image" href="assets/cursors/text-mono.svg" type="image/svg+xml" media="(hover:hover) and (pointer:fine)" />
  {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>}
</head>
<body class="booting scroll-portfolio">
  <svg class="svg-defs" aria-hidden="true" width="0" height="0">
    <defs>
      <clipPath id="crtScreenClip" clipPathUnits="objectBoundingBox">
        <path d="M .035 .018 Q .5 0 .965 .018 Q 1 .5 .965 .982 Q .5 1 .035 .982 Q 0 .5 .035 .018 Z"/>
      </clipPath>
    </defs>
  </svg>
  <section class="boot-loader" id="boot-loader" aria-label="Loading portfolio" data-i18n-aria="boot.label">
    <div class="boot-gate" id="boot-gate">
      <h2 aria-label="LOADING">LOADING</h2>
      <div class="boot-progress" id="boot-progress" role="progressbar" aria-label="Loading" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="boot-progress-bar"></span></div>
    </div>
  </section>

  <main class="shell">
    <div class="crt-stage" id="crt-stage">
      <section class="screen" id="screen" aria-label="Interactive multidisciplinary design portfolio">
        <video class="crt-background-video" muted loop playsinline preload="none" aria-hidden="true">
          <source src="assets/video/crt-ambient.webm" type="video/webm" />
        </video>
        <canvas id="crt-bg" aria-hidden="true"></canvas>
        <canvas id="crt-fx" aria-hidden="true"></canvas>
        <div class="noise" aria-hidden="true"></div>
        <div class="scanlines" aria-hidden="true"></div>
        <div class="screen-reflection" aria-hidden="true"></div>
        <div class="edge-light" aria-hidden="true"></div>

        <div class="scroll-viewport" id="scroll-viewport" tabindex="0" aria-label="Scrollable portfolio">
        <section class="scroll-home" id="scroll-home" aria-label="Home">
        <div class="desktop" id="desktop">
          <div class="crt-head-feature" id="crt-head-feature" aria-hidden="true">
            <canvas id="crt-head-canvas"></canvas>
          </div>

          <section class="hero-intro" aria-label="Portfolio introduction" data-i18n-aria="hero.aria">
            <h1>EDOARDO<br />RAPPANELLO</h1>
            <p class="hero-copy" data-i18n="hero.copy">I work across graphic design, web and digital marketing, with a focus on how each project works in context.</p>
            <button class="primary-action" data-open="projects" data-i18n="hero.cta">ENTER SELECTED WORK</button>
          </section>

          <nav class="desktop-icons" aria-label="Portfolio sections" data-i18n-aria="nav.aria">
            <button class="desktop-icon" data-open="projects">
              <span class="icon-glyph" aria-hidden="true"><svg viewBox="0 0 48 40"><path d="M3 10h16l4-5h22v29H3z"/><path d="M3 13h42"/></svg></span>
              <span data-i18n="nav.projects">PROJECTS</span>
            </button>
            <button class="desktop-icon" data-open="about">
              <span class="icon-glyph" aria-hidden="true"><svg viewBox="0 0 48 40"><path d="M4 6h40v28H4z"/><circle cx="15" cy="16" r="5"/><path d="M7 29c1-5 4-8 8-8s7 3 8 8M28 14h10M28 20h10M28 26h7"/></svg></span>
              <span data-i18n="nav.about">ABOUT.TXT</span>
            </button>
            <button class="desktop-icon" data-open="resume">
              <span class="icon-glyph" aria-hidden="true"><svg viewBox="0 0 40 48"><path d="M7 3h19l7 7v35H7z"/><path d="M26 3v8h7M12 19h16M12 25h16M12 31h11M12 37h14"/></svg></span>
              <span data-i18n="nav.resume">RESUME.TXT</span>
            </button>
            <button class="desktop-icon" data-open="contact">
              <span class="icon-glyph" aria-hidden="true"><svg viewBox="0 0 48 40"><path d="M4 6h40v28H4z"/><path d="M5 8l19 15L43 8"/></svg></span>
              <span data-i18n="nav.contact">CONTACT</span>
            </button>
          </nav>
        </div>

        </section>
        <ScrollSections />
        <PortfolioFooter basePath={basePath} />
        </div>
        <ScrollNavigation basePath={basePath} />
        <div class="scroll-top-rail" aria-hidden="true"></div>
        <div class="scroll-portrait-slot" aria-hidden="true"></div>
        <div class="scroll-folder-morph" aria-hidden="true"></div>

        <button class="language-toggle" id="language-toggle" type="button" aria-label="Switch language">IT</button>
        <aside class="privacy-widget" aria-label="Privacy and cookie preferences">
          <button class="privacy-toggle" id="privacy-toggle" type="button" aria-expanded="false" aria-controls="privacy-panel" data-i18n="privacy.button">PRIVACY / COOKIES</button>
          <div class="privacy-panel" id="privacy-panel" hidden>
            <div class="privacy-status" id="privacy-status" aria-live="polite">ANALYTICS: NOT SET</div>
            <h2 data-i18n="privacy.title">PRIVACY / COOKIES</h2>
            <p data-i18n="privacy.copy">This site uses GA4 analytics only after consent. No advertising or profiling cookies are used. Language, privacy and analytics preferences are stored locally on your device.</p>
            <div class="privacy-actions">
              <button id="privacy-accept" type="button" data-i18n="privacy.accept">ACCEPT ANALYTICS</button>
              <button id="privacy-reject" type="button" data-i18n="privacy.reject">REJECT ANALYTICS</button>
              <button id="privacy-revoke" type="button" hidden data-i18n="privacy.revoke">REVOKE CONSENT</button>
              <button id="privacy-close" type="button" data-i18n="privacy.close">CLOSE</button>
            </div>
          </div>
        </aside>
        <div class="projects-view" id="projects-view" hidden></div>
        <div class="window-layer" id="window-layer" aria-live="polite"></div>
        <IdleScreensaver />
      </section>
    </div>
  </main>

  <StaticReader canonicalPath={canonicalPath} basePath={basePath} lang="en" />
  <StaticReader canonicalPath={canonicalPath} basePath={basePath} lang="it" />
  <script is:inline define:vars={{portfolioDictionaries}}>window.PORTFOLIO_DICTIONARIES = portfolioDictionaries;</script>

  <script is:inline defer src={asset('js/i18n.js')}></script>
  <script is:inline defer src={asset('js/cursor.js')}></script>
  <script is:inline defer src={asset('js/boot.js')}></script>
  <script is:inline defer src={asset('js/hero-copy-contrast.js')}></script>
  <script is:inline defer src={asset('js/analytics.js')}></script>
  <script is:inline defer src={asset('js/privacy.js')}></script>
  <script is:inline defer src={asset('js/portfolio-scroll.js')}></script>
  <script is:inline defer src={asset('js/idle-screensaver.js')}></script>
</body>
</html>

---
import { typographyMode } from "../data/typography.mjs";
const fontSheet = typographyMode === 'pixel-editorial'
  ? 'https://fonts.googleapis.com/css2?family=Doto:wght@400;500;600;700&family=Geist+Pixel:ELSH@0..100&family=Geist:wght@400;500;600;700&display=swap'
  : typographyMode === 'balanced'
  ? 'https://fonts.googleapis.com/css2?family=Doto:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap'
  : typographyMode === 'digital'
  ? 'https://fonts.googleapis.com/css2?family=Doto:wght@400;500;600;700&family=Geist+Pixel:ELSH@0..100&display=swap'
  : 'https://fonts.googleapis.com/css2?family=Doto:wght@400;500;600;700&display=swap';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const faces = [
  {
    "name": "Doto-latin-ext-variable.woff2",
    "range": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF",
    "family": "Doto"
  },
  {
    "name": "Doto-latin-variable.woff2",
    "range": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
    "family": "Doto"
  },
  {
    "name": "JetBrainsMono-latin-ext-variable.woff2",
    "range": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF",
    "family": "JetBrains Mono"
  },
  {
    "name": "JetBrainsMono-latin-variable.woff2",
    "range": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
    "family": "JetBrains Mono"
  }
];
const localCss = faces.map(font => `@font-face{font-family:"${font.family}";font-style:normal;font-weight:400 700;font-display:swap;src:url("${base}assets/font/${font.name}") format("woff2");unicode-range:${font.range}}`).join("\n");
---
{typographyMode === "doto-mono" ? <>
  <link rel="preload" href={`${base}assets/font/Doto-latin-variable.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base}assets/font/JetBrainsMono-latin-variable.woff2`} as="font" type="font/woff2" crossorigin />
  <style is:inline set:html={localCss}></style>
</> : <>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={fontSheet} />
</>}

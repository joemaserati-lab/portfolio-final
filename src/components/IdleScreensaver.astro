<section class="idle-screensaver" id="idle-screensaver" role="dialog" aria-modal="true" aria-label="Screensaver" data-i18n-aria="idle.aria" tabindex="-1" hidden>
  <!-- The 404 page provides the exact original canvas portrait, DVD/VIDEO masks,
       bounce animation, and the canonical typography. No imitation assets. -->
  <iframe class="idle-screensaver__scene" id="idle-screensaver-scene"
          title="Portfolio screensaver" aria-hidden="true" tabindex="-1"
          data-src="404.html?mode=screensaver"></iframe>
  <div class="idle-screensaver__accessible">
    <h2 data-i18n="idle.title">IDLE MODE.</h2>
    <p data-i18n="idle.copy">The screen is taking a break. Your place in the portfolio is saved.</p>
    <span data-i18n="idle.resume">MOVE / TAP / PRESS A KEY TO RESUME</span>
  </div>
</section>

---
---
<section class="idle-screensaver" id="idle-screensaver" role="dialog" aria-modal="true" aria-label="Screensaver" data-i18n-aria="idle.aria" tabindex="-1" hidden>
  <header class="idle-screensaver__topline">
    <span>EDOARDO RAPPANELLO</span>
    <span data-i18n="idle.status">PORTFOLIO OS / IDLE</span>
  </header>
  <div class="idle-screensaver__dvd" id="idle-screensaver-dvd" aria-hidden="true">
    <div class="idle-screensaver__face"><img src="assets/images/profilephoto.webp" width="180" height="180" decoding="async" loading="lazy" alt="" /></div>
    <svg class="idle-screensaver__disc" viewBox="0 0 180 43" focusable="false" aria-hidden="true">
      <path d="M5 8 H175 V21 H5 Z M33 31 H147 V36 H33 Z" fill="currentColor" />
      <ellipse cx="90" cy="20" rx="24" ry="14" stroke="currentColor" stroke-width="5" fill="#050505"/>
      <ellipse cx="90" cy="20" rx="6" ry="4" fill="currentColor"/>
    </svg>
    <span class="idle-screensaver__video">VIDEO</span>
  </div>
  <section class="idle-screensaver__copy">
    <h2 data-i18n="idle.title">IDLE MODE.</h2>
    <p data-i18n="idle.copy">The screen is taking a break. Your place in the portfolio is saved.</p>
    <button type="button" class="idle-screensaver__resume" id="idle-screensaver-resume" data-i18n="idle.resume">MOVE / TAP / PRESS A KEY TO RESUME</button>
  </section>
</section>

---
const sections = [ ['work', 'Selected Work'], ['about', 'About'], ['resume', 'Resume'], ['contact', 'Contact'] ];
---
{sections.map(([kind, name]) => <section class="scroll-section" id={`scroll-${kind}`} aria-label={name} data-i18n-aria={`scroll.${kind}`}>
  <div class="scroll-window os-window" data-kind={kind}>
    <div class="window-titlebar"><span data-scroll-title={kind}>{kind === 'work' ? 'PROJECTS' : kind.toUpperCase()}</span></div>
    <div class="window-body" data-scroll-content={kind}></div>
  </div>
</section>)}

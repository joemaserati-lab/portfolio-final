---
import PortfolioShell from '../../layouts/PortfolioShell.astro';
import { profile, sections } from '../../data/routes.mjs';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: sections.contact.title,
  about: { '@type': 'Person', name: profile.name }
};
---
<PortfolioShell {...sections.contact} canonicalPath={sections.contact.path} jsonLd={jsonLd} />

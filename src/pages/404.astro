---
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <base href={basePath} />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#050003" />
  <title>404 — Edoardo Rappanello</title>
  <link rel="icon" href="assets/favicon/favicon-er.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="css/style.css" />
  <link rel="stylesheet" href="css/fixes.css" />
  <link rel="stylesheet" href="css/purple-theme.css" />
</head>
<body class="not-found-body">
  <main class="not-found-screen" aria-label="Page not found" data-i18n-aria="404.label">
    <section class="not-found-panel">
      <h1>404</h1>
      <p data-i18n="404.copy">The requested page does not exist. Return to the portfolio or open the project directory.</p>
      <div class="not-found-actions">
        <a href="./" data-i18n="404.home">RETURN HOME</a>
        <a href="work/" data-i18n="404.projects">OPEN PROJECTS.DIR</a>
      </div>
    </section>
  </main>
  <script is:inline defer src="js/cursor.js"></script>
  <script is:inline src="js/i18n.js"></script>
</body>
</html>

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="robots" content="noindex" />
<meta name="theme-color" content="#050505" />
<title>404 — Edoardo Rappanello </title>
<style is:global>
@font-face {font-family:'Doto';src:url('/portfolio-final/assets/font/Doto-500.woff2') format('woff2');font-style:normal;font-weight:500;font-display:swap}
@font-face {font-family:'Redaction 50';src:url('/portfolio-final/assets/font/redaction-50-latin-400-normal.woff') format('woff');font-style:normal;font-weight:400;font-display:swap}
:root {color-scheme:dark;--bg:#050505;--text:#f5f5f5;--secondary:#b9b9b9;--line:rgba(255,255,255,.18);--accent:#f5f5f5;--mint:#80FFCC}
*,*::before,*::after {box-sizing:border-box}
html,body {margin:0;width:100%;height:100%;background:var(--bg)}
body {font-family:'Doto','Courier New',monospace;font-weight:500;color:var(--text);overflow:hidden;-webkit-font-smoothing:antialiased}
a,button {font:inherit;color:inherit}
a:focus-visible,button:focus-visible {outline:2px solid var(--mint);outline-offset:6px}
a {-webkit-tap-highlight-color:transparent}
::selection{background:var(--accent);color:var(--bg)}
.scene {position:relative;isolation:isolate;height:100vh;height:100dvh;min-height:300px;overflow:hidden;background:var(--bg)}
/* CRT treatment follows the portfolio. One restrained overlay, no decorative UI. */
.scene::after {content:'';position:absolute;z-index:5;inset:0;pointer-events:none;background:repeating-linear-gradient(180deg,rgba(255,255,255,.022) 0 1px,transparent 1px 3px)}
.topline {position:absolute;top:clamp(22px,4vw,48px);left:clamp(24px,5vw,76px);right:clamp(24px,5vw,76px);display:flex;align-items:baseline;justify-content:space-between;gap:20px;z-index:3;font-size:clamp(12px,1.1vw,16px);letter-spacing:.015em}
.topline__brand {color:var(--accent);text-decoration:none;transition:color .15s}
.topline__brand:hover {color:#fff}
.scene__copy {position:absolute;z-index:3;left:clamp(24px,5vw,76px);bottom:clamp(36px,7.5vh,100px);max-width:min(550px,calc(100% - 48px));pointer-events:none}
.scene__copy h1 {font-family:'Redaction 50',Georgia,serif;font-size:clamp(110px,19vw,235px);font-weight:400;letter-spacing:-.075em;line-height:.75;margin:0 0 28px -6px;color:var(--text)}
.scene__copy p {font-size:clamp(16px,1.5vw,21px);color:var(--secondary);line-height:1.25;margin:0 0 23px;max-width:31ch}
.scene__home {display:inline-block;pointer-events:auto;font-size:clamp(14px,1.2vw,18px);text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:4px;color:var(--text);transition:color .16s}
.scene__home:hover {color:var(--secondary)}
/* This is the only moving object: portrait in place of "DVD", original disc and VIDEO underneath. */
.dvd {--dvd-color:#f5f5f5;position:absolute;z-index:2;top:0;left:0;display:flex;flex-direction:column;align-items:center;width:clamp(160px,17.5vw,246px);height:clamp(158px,18vw,224px);color:var(--dvd-color);transform:translate3d(0,0,0);will-change:transform;pointer-events:none;user-select:none}
.dvd__face {position:relative;flex:0 0 67%;height:67%;width:65%;display:flex;justify-content:center;align-items:flex-end;overflow:hidden}
.dvd__canvas {position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:none}
.dvd.has-image .dvd__canvas {display:block}
.dvd__fallback {font-family:'Redaction 50',Georgia,serif;font-size:clamp(105px,11vw,158px);line-height:1.0;transform:translateY(18px);color:currentColor}
.dvd.has-image .dvd__fallback {display:none}
.dvd__disc {flex:0 0 17%;width:100%;height:17%;background-color:currentColor;mask-image:url('data:image/png;base64,');mask-repeat:no-repeat;mask-position:center;mask-size:contain;-webkit-mask-image:url('data:image/png;base64,');-webkit-mask-repeat:no-repeat;-webkit-mask-position:center;-webkit-mask-size:contain}
.dvd__video {margin-top:2.5%;flex:0 0 11%;height:11%;width:84%;background-color:currentColor;mask-image:url('data:image/png;base64,');mask-repeat:no-repeat;mask-position:center;mask-size:contain;-webkit-mask-image:url('data:image/png;base64,');-webkit-mask-repeat:no-repeat;-webkit-mask-position:center;-webkit-mask-size:contain}
@media(max-width:700px) {
 .topline {top:26px;left:24px;right:24px}
 .scene__copy {bottom:125px;left:24px;max-width:calc(100% - 48px)}
 .scene__copy h1 {font-size:clamp(104px,28vw,170px);margin-bottom:23px}
 .scene__copy p {font-size:16px;margin-bottom:16px}
 .dvd {width:clamp(150px,43vw,195px);height:clamp(150px,43vw,195px)}
 .dvd__fallback {font-size:clamp(106px,30vw,144px)}
}
@media(max-height:510px) and (min-width:701px){.scene__copy {bottom:27px}.scene__copy h1 {font-size:clamp(90px,27vh,148px);margin-bottom:12px}.scene__copy p {margin-bottom:12px}}
@media(max-height:470px) and (max-width:700px){.scene__copy {bottom:26px}.scene__copy h1 {font-size:85px;margin-bottom:12px}.scene__copy p {margin-bottom:10px}}

</style>
</head>
<body>
<main class="scene" data-stage aria-label="Page not found">
  <header class="topline">
    <a class="topline__brand" href="https://joemaserati-lab.github.io/portfolio-final/">EDOARDO RAPPANELLO</a>
  </header>
  <div class="dvd" data-dvd aria-hidden="true">
    <div class="dvd__face">
      <span class="dvd__fallback">?</span>
      <canvas class="dvd__canvas" data-face-canvas width="360" height="360"></canvas>
    </div>
    <div class="dvd__disc" aria-hidden="true"></div>
    <div class="dvd__video" aria-hidden="true"></div>
  </div>
  <section class="scene__copy" aria-labelledby="page-title">
    <h1 id="page-title">404</h1>
    <p data-copy>Nothing at this address.</p>
    <a class="scene__home" data-home href="https://joemaserati-lab.github.io/portfolio-final/">← BACK TO PORTFOLIO</a>
  </section>
</main>
<script is:inline>
(() => {
 'use strict';
 const stage = document.querySelector('[data-stage]');
 const sprite = document.querySelector('[data-dvd]');
 const canvas = document.querySelector('[data-face-canvas]');
 if (!stage || !sprite) return;
 // The DVD portrait is monochrome; only one of six collision phases is mint.
 const colors = ['#f5f5f5','#b9b9b9','#dedede','#838383','#80FFCC','#cfcfcf'];
 let colorIndex = 0;
 let x = 0, y = 0, vx = 155, vy = 113, lastFrame = 0;
 let width = 0, height = 0, maxX = 0, maxY = 0;
 let basePixels = null, faceContext = null, faceFlat = false;
 let collisionCount = 0;
 const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 let paused = reduceMotion;
 const sample = (image, sw, sh) => {
   // Crop transparent whitespace, retaining the actual head proportions.
   const temp = document.createElement('canvas');
   const r = Math.min(1, 900/Math.max(sw,sh));
   temp.width=Math.max(1,Math.round(sw*r));temp.height=Math.max(1,Math.round(sh*r));
   const t=temp.getContext('2d',{willReadFrequently:true});
   t.drawImage(image,0,0,temp.width,temp.height);
   const data=t.getImageData(0,0,temp.width,temp.height);
   let minX=temp.width,minY=temp.height,maxPx=-1,maxPy=-1;
   let transparent = false;
   for(let py=0;py<temp.height;py++) for(let px=0;px<temp.width;px++) {
     const a = data.data[(py*temp.width+px)*4+3];
     if (a<248) transparent = true;
     if (a>30) {minX=Math.min(minX,px);minY=Math.min(minY,py);maxPx=Math.max(maxPx,px);maxPy=Math.max(maxPy,py)}
   }
   if (maxPx<minX) throw new Error('Empty image');
   const region = {x:minX,y:minY,w:maxPx-minX+1,h:maxPy-minY+1};
   // A 5% margin prevents the head touching the top edge.
   const gutter = 16;
   const scaled = Math.min((canvas.width-gutter*2)/region.w,(canvas.height-gutter*2)/region.h);
   const dw=region.w*scaled,dh=region.h*scaled;
   faceContext = canvas.getContext('2d',{willReadFrequently:true});
   faceContext.clearRect(0,0,canvas.width,canvas.height);
   const sx=region.x/r,sy=region.y/r,swOriginal=region.w/r,shOriginal=region.h/r;
   faceContext.drawImage(image,sx,sy,swOriginal,shOriginal,(canvas.width-dw)/2,(canvas.height-dh)/2,dw,dh);
   basePixels=faceContext.getImageData(0,0,canvas.width,canvas.height);
   let n=0,sum=0,sum2=0;
   const bytes=basePixels.data;
   for(let i=0;i<bytes.length;i+=4){
     if (bytes[i+3]<25) continue;
     const l=(bytes[i]*.2126+bytes[i+1]*.7152+bytes[i+2]*.0722)/255;
     sum+=l;sum2+=l*l;n++;
   }
   faceFlat=n>0&&(sum2/n-(sum/n)**2)<.006;
   sprite.classList.add('has-image');
   recolor();
 };
 function recolor(){
   sprite.style.setProperty('--dvd-color',colors[colorIndex]);
   if (!basePixels || !faceContext) return;
   const color=colors[colorIndex];
   const rgb=[1,3,5].map(i=>parseInt(color.slice(i,i+2),16));
   const dst=faceContext.createImageData(basePixels.width,basePixels.height);
   const source=basePixels.data, pixels=dst.data;
   for(let i=0;i<source.length;i+=4){
     const a=source[i+3];
     if(!a) continue;
     const l=(source[i]*.2126+source[i+1]*.7152+source[i+2]*.0722)/255;
     // A fully black silhouette stays visible; photographs retain their midtones.
     const lightness=faceFlat?.91:(.25+.75*Math.pow(l,.88));
     pixels[i]=Math.round(rgb[0]*lightness);
     pixels[i+1]=Math.round(rgb[1]*lightness);
     pixels[i+2]=Math.round(rgb[2]*lightness);
     pixels[i+3]=a;
   }
   faceContext.putImageData(dst,0,0);
 }
 function resize(initial=false){
   width=stage.clientWidth;height=stage.clientHeight;
   maxX=Math.max(0,width-sprite.offsetWidth);maxY=Math.max(0,height-sprite.offsetHeight);
   if (initial) {x=maxX*.64;y=maxY*.25;}
   else {x=Math.max(0,Math.min(maxX,x));y=Math.max(0,Math.min(maxY,y));}
   paint();
 }
 function paint(){sprite.style.transform=`translate3d(${x.toFixed(2)}px,${y.toFixed(2)}px,0)`}
 function move(dt){
   let nextX=x+vx*dt,nextY=y+vy*dt;
   let hitX=false,hitY=false;
   if(maxX>0 && nextX>=maxX){nextX=2*maxX-nextX;vx=-Math.abs(vx);hitX=true}
   else if(nextX<=0){nextX=-nextX;vx=Math.abs(vx);hitX=true}
   if(maxY>0 && nextY>=maxY){nextY=2*maxY-nextY;vy=-Math.abs(vy);hitY=true}
   else if(nextY<=0){nextY=-nextY;vy=Math.abs(vy);hitY=true}
   x=Math.max(0,Math.min(maxX,nextX));y=Math.max(0,Math.min(maxY,nextY));
   if(hitX||hitY){colorIndex=(colorIndex+1)%colors.length;collisionCount++;recolor();}
   paint();
 }
 function frame(ts){
   if(!lastFrame) lastFrame=ts;
   const dt=Math.min((ts-lastFrame)/1000,.05);
   lastFrame=ts;
   if(!paused) move(dt);
   requestAnimationFrame(frame);
 }
 document.addEventListener('visibilitychange',()=>{lastFrame=0});
 window.addEventListener('resize',()=>resize(),{passive:true});
 const lang=(()=>{try{return localStorage.getItem('portfolioLang')==='it'?'it':'en'}catch{return 'en'}})();
 if(lang==='it'){
   document.documentElement.lang='it';
   document.querySelector('[data-copy]').textContent='Non c’è nulla a questo indirizzo.';
   document.querySelector('[data-home]').textContent='← TORNA AL PORTFOLIO';
 }
 const faceImage=new Image();
 faceImage.onload=()=>sample(faceImage,faceImage.naturalWidth,faceImage.naturalHeight);
 faceImage.onerror=()=>{/* Keep fallback if the portrait cannot be decoded. */};
 faceImage.src='data:image/webp;base64,';
 recolor();resize(true);requestAnimationFrame(frame);
})();
</script>
</body>
</html>
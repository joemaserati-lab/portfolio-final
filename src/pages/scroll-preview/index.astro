---
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(basePath, Astro.site);
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8" /><meta name="robots" content="noindex, follow" />
<link rel="canonical" href={canonical} /><title>Portfolio — Edoardo Rappanello</title>
<script is:inline define:vars={{basePath}}>
  const hash = location.hash.slice(1);
  let path = '';
  if (hash.startsWith('project=')) path = `work/${encodeURIComponent(decodeURIComponent(hash.slice(8)))}/`;
  else if (['work','about','contact','resume'].includes(hash)) path = `${hash}/`;
  location.replace(basePath + path);
</script>
<meta http-equiv="refresh" content={`2;url=${basePath}`} />
</head><body><a href={basePath}>Open portfolio</a></body></html>
